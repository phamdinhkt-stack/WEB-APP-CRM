# Biến môi trường khai báo trên Vercel: Project → Settings → Environment Variables
# 1) Kho dữ liệu: Vercel → Storage/Marketplace → Upstash for Redis → Connect (Vercel tự thêm 2 biến này)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 2) SePay: my.sepay.vn → Tích hợp Webhooks → Kiểu chứng thực "API Key" → đặt cùng giá trị ở đây
SEPAY_API_KEY=
# 3) Khóa để phần mềm quản lý (app/) lấy đơn từ máy chủ — tự đặt một chuỗi dài, khó đoán
CRM_SYNC_KEY=
# 4) (Tuỳ chọn) Email xác nhận cho khách qua Resend — RESEND_FROM phải thuộc tên miền đã xác minh trên resend.com
RESEND_API_KEY=
RESEND_FROM=Spa HOA MAI <datlich@ten-mien-cua-ban.vn>
# 5) (Tuỳ chọn) Báo Telegram cho từng bộ phận — tạo bot qua @BotFather, lấy chat id của từng nhóm
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_LETAN=
TELEGRAM_CHAT_THUNGAN=
TELEGRAM_CHAT_KETOAN=
# 6) (Tuỳ chọn) Chatbot "Tư vấn trực tiếp" trả lời bằng AI — lấy khóa tại console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# 7) Báo tin nhắn Zalo cho admin khi có khách mới (qua Zalo Official Account của spa)
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_REFRESH_TOKEN=
ZALO_ADMIN_CODE=
ZALO_OA_SECRET_KEY=
ZALO_ADMIN_USER_ID=
# (Tuỳ chọn, tính phí) ZNS: gửi theo số điện thoại admin bằng mẫu tin đã duyệt, tham số: ten_khach, sdt_khach, noi_dung, thoi_gian
ZALO_ADMIN_PHONE=
ZALO_ZNS_TEMPLATE_ID=
